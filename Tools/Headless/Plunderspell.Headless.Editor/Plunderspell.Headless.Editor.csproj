<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Compiles the game's editor tooling (scene builders, forges) against the shimmed UnityEditor
    surface in ../Shims/UnityEditor.cs, plus the runtime project it calls into. Nothing here DOES
    anything: editor tools cannot meaningfully run outside the editor, but a compile error in
    them is caught before someone opens Unity. See Tools/Headless/README.md.
  -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>Plunderspell.Headless.Editor</AssemblyName>
    <RootNamespace>Plunderspell.Headless.Editor</RootNamespace>
    <DefineConstants>HEADLESS;UNITY_EDITOR</DefineConstants>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0067;CS0414;CS0169</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Plunderspell.Headless/Plunderspell.Headless.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Excluded: PlayerBuilder (issue #53) calls BuildPipeline.BuildPlayer/BuildReport, which the
      UnityEditor shim does not model — a shimmed "successful build" would prove nothing, since the
      whole point of that tool is to invoke the real Editor's build pipeline. Verified against the
      real Unity Editor directly instead (see docs/plans/GitIssues/Issue_53_Plan.md). Same
      reasoning as the Steam invite gateway exclusion in the Runtime project.
    -->
    <Compile Include="../../../Assets/_Project/Scripts/Editor/**/*.cs"
              Exclude="../../../Assets/_Project/Scripts/Editor/PlayerBuilder.cs">
      <Link>Editor/%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>
